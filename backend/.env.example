# Application
APP_NAME=Log Summarizer ML
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database (optional - for future use)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/logsummarizer
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis (optional - for caching)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ML Models
SUMMARIZATION_MODEL=facebook/bart-large-cnn
CLASSIFICATION_MODEL=microsoft/deberta-v3-base
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEVICE=cpu

# Log Processing
MAX_LOG_SIZE_MB=100
BATCH_SIZE=1000
SUPPORTED_FORMATS=.log,.txt,.csv,.json

# Anomaly Detection
ANOMALY_CONTAMINATION=0.1
CLUSTERING_EPS=0.5
CLUSTERING_MIN_SAMPLES=5